#!/usr/bin/env python

import imas, argparse, yaml
import numpy as np
import matplotlib, os
if 'DISPLAY' not in os.environ:
    matplotlib.use('agg')
else:
    matplotlib.use('TKagg')
import matplotlib.pyplot as plt

#plt.style.use('dark_background')

# ---------------------------------------------------------------
def find_nearest(a, a0):
    'Element in nd array `a` closest to the scalar value `a0`'
    idx = abs(a - a0).argmin()
    return a.flat[idx],idx

# ---------------------------------------------------------------
# MANAGEMENT OF INPUT ARGUMENTS

parser = argparse.ArgumentParser(description=\
                   '---- Run script according to parameters from input configuration folder')
parser.add_argument('-c','--config_folder',help='Configuration folder',required=False,type=str)

# CONFIGURATION FOLDER
args = vars(parser.parse_args())
config_folder = args["config_folder"]
if config_folder is None:
    config_folder = 'input'

# ---------------------------------------------------------------

# Read scenario.yaml used for the simulation to know where to find
# the IMAS output datafile
scenario_file = open(config_folder+'/scenario.yaml', 'r')
config = yaml.load(scenario_file,Loader=yaml.CLoader)
scenario_file.close()

# Backen
if config['scenario_backend'] == 'hdf5':
    sc_backend = imas.imasdef.HDF5_BACKEND
else:
    sc_backend = imas.imasdef.MDSPLUS_BACKEND
    
# Find output datafile from the configuration parameters
if config['output_user_or_path'] == 'default':
    output_user_or_path = os.getenv('USER')
    config['output_user_or_path'] = os.getenv('USER')
else:
    output_user_or_path = config['output_user_or_path']

# Read the equilibrium and core_profiles IDSs from the input datafile
input = imas.DBEntry(sc_backend,
         config['input_database'],
         config['pulse'],
         config['run_in'],
         config['input_user_or_path'])
input.open()
core_profiles_ref = input.get_slice('core_profiles',config['time_slice'],1)
input.close()

# Read the output core_profiles IDS
output = imas.DBEntry(imas.imasdef.HDF5_BACKEND,
          config['output_database'],
          config['pulse'],
          config['run_out'],
          config['output_user_or_path'])
output.open()
core_profiles = output.get('core_profiles')
output.close()

#plt.figure()
#plt.plot(core_profiles_ref.time,core_profiles_ref.global_quantities.n_e_volume_average,
#         label='Ref input')
#plt.plot(core_profiles.time,core_profiles.global_quantities.n_e_volume_average,
#         label='Result')
#plt.grid()
#plt.legend(loc='lower right')
#plt.xlabel('Time [s]')
#plt.ylabel('Volume-averaged electron density [m-3]')


from mpl_toolkits.mplot3d import axes3d
from matplotlib import cm

ax = plt.figure().add_subplot(projection='3d')

dimx = len(core_profiles.profiles_1d[0].grid.rho_tor_norm)
dimy = len(core_profiles.time)
dimz = len(core_profiles.profiles_1d[0].electrons.density)

X = np.empty((dimx,dimy), dtype=float, order='C')
Y = np.empty((dimx,dimy), dtype=float, order='C')
Z = np.empty((dimx,dimy), dtype=float, order='C')

for j in range(dimy):
    X[:,j] = core_profiles.profiles_1d[j].grid.rho_tor_norm[:]
    Z[:,j] = core_profiles.profiles_1d[j].electrons.density[:]

for i in range(dimx):
    Y[i,:] = core_profiles.time[:]

# Axis limits
xmin = X.min()
xmax = X.max()
ymin = Y.min()
ymax = Y.max()
zmin = Z.min()
zmax = Z.max()
xwidth = abs(xmax-xmin)
ywidth = abs(ymax-ymin)
zwidth = abs(zmax-zmin)
r = 0.25

# Plot the 3D surface
ax.plot_surface(X, Y, Z, edgecolor='royalblue', lw=0.5, rstride=int(dimx/10.0), cstride=2,
                alpha=0.3)
ax.set_title("SMART")

# Plot projections of the contours for each dimension.  By choosing offsets
# that match the appropriate axes limits, the projected contours will sit on
# the 'walls' of the graph
ax.contourf(X, Y, Z, zdir='z', offset=zmin - r*zwidth, cmap='Blues')
#ax.contourf(X, Y, Z, zdir='x', offset=xmin - r*xwidth, cmap='viridis')
ax.contourf(X, Y, Z, zdir='y', offset=ymax + r*ywidth, cmap='Blues')

ax.set(#xlim=(xmin-r*xwidth, xmax+r*xwidth),
       xlim=(xmin, xmax),
       ylim=(ymin-r*ywidth, ymax+r*ywidth),
       zlim=(zmin-r*zwidth, zmax+r*zwidth),
       xlabel='rho_tor_norm', ylabel='Time [s]', zlabel='Electron Density [m-3]')


plt.show()
